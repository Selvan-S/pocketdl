# Normalize text files in the repository to LF.
* text=auto eol=lf

# Shell scripts and the Termux launcher must stay LF: Termux bash rejects a
# CRLF shebang with "bad interpreter". The local dev machine uses
# core.autocrlf=true, so this is enforced here rather than per-clone.
*.sh text eol=lf
scripts/pocketdl text eol=lf

# Binary/graphic assets must never be line-ending converted.
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.ico binary
*.webp binary
*.woff binary
*.woff2 binary
